QMainWindow, QWidget {
    background: #07111F;
    color: #EAF2FF;
    font-family: "Segoe UI";
}
QFrame#sidebar {
    background: #0B1728;
    border-right: 1px solid #1E3550;
}
QFrame#topHeader {
    background: #061426;
    border-bottom: 1px solid #1E3550;
    min-height: 68px;
}
QLabel#headerLogo {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 2px;
}
QLabel#headerContext, QLabel#headerMeta, QLabel#headerUser {
    color: #8FA9C4;
    font-size: 11px;
}
QLabel#headerUser { color: #D9E9F7; font-weight: 700; }
QFrame#headerSeparator { color: #29445F; background: #29445F; max-width: 1px; }
QFrame#panel, QFrame#statCard, QFrame#heroPanel {
    background: #101F33;
    border: 1px solid #1E3550;
    border-radius: 12px;
}
QFrame#heroPanel {
    background: #13263D;
}
QLabel#brand {
    color: #FFFFFF;
    font-size: 25px;
    font-weight: 800;
}
QLabel#eyebrow {
    color: #7EC8FF;
    font-size: 10px;
    font-weight: 700;
}
QLabel#pageTitle {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: 800;
}
QLabel#pageSubtitle, QLabel#muted {
    color: #91A6BC;
    font-size: 12px;
}
QLabel#statLabel { color: #91A6BC; font-size: 11px; }
QLabel#statValue { color: #FFFFFF; font-size: 25px; font-weight: 800; }
QLabel#statDetail { color: #718BA5; font-size: 10px; }
QPushButton#navButton {
    background: transparent;
    color: #AFC2D6;
    border: none;
    border-radius: 8px;
    padding: 10px 12px;
    text-align: left;
    font-weight: 600;
}
QPushButton#navButton:hover, QPushButton#navButton:checked {
    background: #173B5E;
    color: #FFFFFF;
}
QPushButton#primaryButton {
    background: #2A9DCE;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 9px 14px;
    font-weight: 700;
}
QPushButton#primaryButton:hover { background: #38B7E8; }
QPushButton#secondaryButton {
    background: #172D47;
    color: #C5D7E9;
    border: 1px solid #2B4A6B;
    border-radius: 7px;
    padding: 8px 12px;
}
QPushButton#secondaryButton:hover { background: #244D76; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background: #0D1B2E;
    color: #EAF2FF;
    border: 1px solid #29445F;
    border-radius: 6px;
    padding: 7px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #4EC5F5;
}
QTableWidget {
    background: #0D1B2E;
    alternate-background-color: #11253D;
    color: #EAF2FF;
    border: 1px solid #1E3550;
    border-radius: 8px;
    gridline-color: #1B3550;
    selection-background-color: #245B86;
}
QHeaderView::section {
    background: #17324E;
    color: #BFE8FF;
    border: none;
    padding: 8px;
    font-weight: 700;
}
QScrollBar:vertical {
    background: #0B1728;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #315777;
    border-radius: 5px;
    min-height: 24px;
}
QMessageBox { background: #101F33; }
QDialog { background: #0B1728; }
