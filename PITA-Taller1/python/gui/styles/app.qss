/* Stylesheet para NexoCampus - Tema Verde Institucional */

* {
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
}

QWidget, QLabel, QFrame, QDialog, QMessageBox, QTableWidget, QTextEdit, QPlainTextEdit, QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    color: #0F172A;
}

QMainWindow, QWidget#centralWidget {
    background-color: #F8FAFC;
}

/* Sidebar */
QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #14532D, stop:1 #166534);
    border: none;
}

QLabel#brandName {
    font-weight: 900;
    font-size: 17px;
    color: #FFFFFF;
    letter-spacing: 0.3px;
}

QLabel#brandSub {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.65);
}

QLabel#navSectionLabel {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    padding-left: 18px;
    padding-top: 10px;
    padding-bottom: 2px;
}

QPushButton#navButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.7);
    border: none;
    border-radius: 8px;
    padding: 9px 14px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#navButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
}

QPushButton#navButton[active="true"] {
    background-color: #16A34A;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#subNavButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.6);
    border: none;
    border-radius: 6px;
    padding: 7px 12px 7px 36px;
    text-align: left;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#subNavButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
}

QPushButton#subNavButton[active="true"] {
    background-color: rgba(255, 255, 255, 0.14);
    color: #86EFAC;
    font-weight: 700;
    border-left: 3px solid #86EFAC;
}

/* Header */
QFrame#topHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    min-height: 58px;
    max-height: 58px;
}

QLabel#headerLogo {
    font-weight: 800;
    font-size: 15px;
    color: #14532D;
    letter-spacing: 0.3px;
}

QLabel#headerSub {
    font-size: 11px;
    color: #94A3B8;
}

QLineEdit#headerSearch {
    background-color: #F1F5F9;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 7px 12px;
    font-size: 12px;
    color: #0F172A;
}

QLineEdit#headerSearch:focus {
    border: 1px solid #16A34A;
    background-color: #FFFFFF;
}

/* Cards */
QFrame#statCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QFrame#statCard:hover {
    border-color: #BBF7D0;
}

QLabel#statValue {
    font-size: 24px;
    font-weight: 800;
    color: #0F172A;
}

QLabel#statLabel {
    font-size: 11px;
    color: #64748B;
    font-weight: 600;
}

QLabel#statSub {
    font-size: 11px;
    color: #94A3B8;
}

/* Panels */
QFrame#panel {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QLabel#panelTitle {
    font-size: 13px;
    font-weight: 700;
    color: #0F172A;
}

/* Quick Action Button */
QPushButton#quickActionButton {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 14px 10px;
    font-size: 12px;
    font-weight: 600;
    color: #0F172A;
    text-align: center;
}

QPushButton#quickActionButton:hover {
    border-color: #86EFAC;
    background-color: #F0FDF4;
}

/* Standard Buttons */
QPushButton#primaryButton {
    background-color: #16A34A;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #15803D;
}

QPushButton#secondaryButton {
    background-color: transparent;
    color: #16A34A;
    border: 1.5px solid #16A34A;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#secondaryButton:hover {
    background-color: #F0FDF4;
}

QPushButton#ghostButton {
    background-color: #F1F5F9;
    color: #475569;
    border: none;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#ghostButton:hover {
    background-color: #E2E8F0;
}

QPushButton#tableActionButton {
    background-color: #F1F5F9;
    border: none;
    border-radius: 7px;
    padding: 0;
}

QPushButton#tableActionButton:hover {
    background-color: #DCFCE7;
}

QPushButton#tableActionButton:last-child:hover {
    background-color: #FEE2E2;
}

QPushButton#pageButton, QPushButton#activePageButton {
    background-color: #F1F5F9;
    color: #64748B;
    border: none;
    border-radius: 7px;
    padding: 0;
    font-size: 12px;
}

QPushButton#activePageButton {
    background-color: #16A34A;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#pageNavButton {
    background-color: #F1F5F9;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 7px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#pageNavButton:hover {
    background-color: #E2E8F0;
    color: #0F172A;
}

QPushButton#pageNavButton:disabled {
    background-color: transparent;
    color: #CBD5E1;
    border-color: #F1F5F9;
}

/* Inputs & Forms */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    padding: 7px 10px;
    font-size: 12px;
}

QDateEdit {
    min-width: 140px;
    min-height: 32px;
    padding-right: 4px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 1.5px solid #16A34A;
}

/* Calendar popup (QDateEdit) — no estilizar ::drop-down o se rompe el popup */
QCalendarWidget {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
    color: #0F172A;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #0F172A;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background-color: #DCFCE7;
    color: #14532D;
}

QCalendarWidget QSpinBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    selection-background-color: #16A34A;
    selection-color: #FFFFFF;
    outline: none;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #0F172A;
    background-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #94A3B8;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
}

/* Tables */
QTableWidget {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #F1F5F9;
    selection-background-color: #DCFCE7;
    selection-color: #14532D;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Dialogs, text areas & scrollbars */
QDialog, QMessageBox {
    background-color: #FFFFFF;
    color: #0F172A;
}

QDialog QWidget, QMessageBox QLabel, QMessageBox QWidget {
    background-color: transparent;
    color: #0F172A;
}

QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 10px;
    font-size: 12px;
    selection-background-color: #DCFCE7;
    selection-color: #14532D;
}

QScrollArea {
    background-color: #F8FAFC;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #F8FAFC;
}

QAbstractScrollArea::viewport {
    background-color: #FFFFFF;
}

QChartView {
    background-color: #FFFFFF;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 3px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

/* QTabWidget y QTabBar institucional */
QTabWidget#reportsTabWidget::pane {
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: #F1F5F9;
    color: #64748B;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    margin-right: 4px;
}

QTabBar::tab:hover {
    background-color: #E2E8F0;
    color: #0F172A;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #16A34A;
    font-weight: 700;
    border-bottom: 3px solid #16A34A;
}

